<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="#f5f5dc"> <!-- لون خلفية بيج -->

<TextView
    android:id="@+id/textView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Majors"
    android:textColor="#000000"
android:textSize="60sp"
android:textStyle="bold"
android:gravity="center"
android:layout_marginTop="20dp"/>

<Button
    android:id="@+id/button_cyber_security"
    android:layout_width="256dp"
    android:layout_height="59dp"
    android:backgroundTint="@android:color/holo_red_dark"
    android:text="cyber security"
    android:textSize="20sp"
    android:layout_below="@id/textView"
    android:layout_centerHorizontal="true"
    android:layout_marginTop="50dp"
    android:contentDescription="@string/btn_cyber_security" />

<Button
    android:id="@+id/button_multimedia"
    android:layout_width="256dp"
    android:layout_height="59dp"
    android:backgroundTint="@android:color/holo_red_dark"
    android:text="IT aplications"
    android:textSize="20sp"
    android:layout_below="@id/button_cyber_security"
    android:layout_centerHorizontal="true"
    android:layout_marginTop="20dp"
    android:contentDescription="@string/btn_multimedia" />

<Button
    android:id="@+id/button_diploma"
    android:layout_width="256dp"
    android:layout_height="59dp"
    android:backgroundTint="@android:color/holo_red_dark"
    android:text="diploma mobile applications"
    android:textSize="20sp"
    android:layout_below="@id/button_multimedia"
    android:layout_centerHorizontal="true"
    android:layout_marginTop="20dp"
    android:contentDescription="@string/btn_diploma_mobile_apps" />

    <Button
        android:id="@+id/button_computer_science"
        android:layout_width="256dp"
        android:layout_height="59dp"
        android:layout_below="@id/button_diploma"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="282dp"
        android:backgroundTint="@android:color/holo_red_dark"
        android:contentDescription="@string/lbl_computer_science"
        android:text="computer science"
        android:textSize="20sp" />
    <ImageButton
        android:id="@+id/imageButton13"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="@string/btn_back"
        android:scaleType="fitCenter"
        android:src="@drawable/backbtn2" />

    <ImageButton
        android:id="@+id/imageButton12"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="325dp"
        android:layout_marginTop="641dp"
        android:layout_marginEnd="38dp"
        android:layout_marginBottom="42dp"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="@string/btn_home"
        android:scaleType="fitCenter"
        android:src="@drawable/homebtn" />

</RelativeLayout>

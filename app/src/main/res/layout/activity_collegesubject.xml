<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f5f5dc"
    android:padding="16dp">

    <!-- TextView for Mandatory Subjects -->

    <!-- Spinner for Mandatory Subjects -->

    <TextView

        android:layout_width="365dp"
        android:layout_height="57dp"
        android:layout_marginBottom="8dp"
        android:text="Mandatory Subjects"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="25dp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerMandatory"
        android:textAlignment="center"
        android:layout_width="377dp"
        android:layout_height="82dp"
        android:layout_marginBottom="16dp"
        android:spinnerMode="dropdown" />

    <!-- TextView for Elective Requirements -->

    <!-- Spinner for Elective Requirements -->

    <TextView
        android:layout_width="365dp"
        android:layout_height="57dp"
        android:layout_marginBottom="8dp"
        android:text="Elective Requirements"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="25dp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerElective"
        android:textAlignment="center"
        android:layout_width="377dp"
        android:layout_height="82dp"
        android:spinnerMode="dropdown" />

    <ImageButton
        android:id="@+id/imageButton12"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="@string/btn_home"
        android:scaleType="fitCenter"
        android:src="@drawable/homebtn" />

    <ImageButton
        android:id="@+id/imageButton13"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="@string/btn_back"
        android:scaleType="fitCenter"
        android:src="@drawable/backbtn2" />
</LinearLayout>

            android:backgroundTint="@android:color/holo_red_dark"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btn_mobile_app_development"
            android:layout_width="380dp"
            android:layout_height="70dp"
            android:text="MOBILE APP DEVELOPMENT"
            android:backgroundTint="@android:color/holo_red_dark"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btn_database_management_systems"
            android:layout_width="380dp"
            android:layout_height="70dp"
            android:text="DATABASE MANAGEMENT SYSTEMS"
            android:backgroundTint="@android:color/holo_red_dark"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btn_operating_systems"
            android:layout_width="380dp"
            android:layout_height="70dp"
            android:text="OPERATING SYSTEMS"
            android:backgroundTint="@android:color/holo_red_dark"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btn_advanced_algorithms"
            android:layout_width="380dp"
            android:layout_height="70dp"
            android:text="ADVANCED ALGORITHMS"
            android:backgroundTint="@android:color/holo_red_dark"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btn_advanced_programming"
            android:layout_width="380dp"
            android:layout_height="70dp"
            android:text="ADVANCED PROGRAMMING"
            android:backgroundTint="@android:color/holo_red_dark"

            android:layout_width="380dp"
            android:layout_height="70dp"
            android:text="PROGRAMMING LANGUAGES"
            android:backgroundTint="@android:color/holo_red_dark"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btn_data_analysis"
            android:layout_width="380dp"
            android:layout_height="70dp"
            android:text="DATA ANALYSIS"
            android:backgroundTint="@android:color/holo_red_dark"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btn_software_development"
            android:layout_width="380dp"
            android:layout_height="70dp"
            android:text="SOFTWARE DEVELOPMENT"
            android:backgroundTint="@android:color/holo_red_dark"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btn_web_development"
            android:layout_width="380dp"
            android:layout_height="70dp"
            android:text="WEB DEVELOPMENT"
            android:backgroundTint="@android:color/holo_red_dark"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btn_machine_learning"
            android:layout_width="380dp"
            android:layout_height="70dp"
            android:text="MACHINE LEARNING"
            android:backgroundTint="@android:color/holo_red_dark"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btn_computer_graphics"
            android:layout_width="380dp"
            android:layout_height="70dp"
            android:text="COMPUTER GRAPHICS"
            android:backgroundTint="@android:color/holo_red_dark"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btn_network_security"
            android:layout_width="380dp"
            android:layout_height="70dp"
            android:text="NETWORK SECURITY"
            android:backgroundTint="@android:color/holo_red_dark"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btn_cloud_computing"
            android:layout_width="380dp"
            android:layout_height="70dp"

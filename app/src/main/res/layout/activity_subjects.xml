        <Button
            android:id="@+id/btn_data_mining"
            android:layout_width="380dp"
            android:layout_height="70dp"
            android:text="DATA MINING"
            android:backgroundTint="@android:color/holo_red_dark"
            android:textSize="18sp" />

    </LinearLayout>
</ScrollView>
